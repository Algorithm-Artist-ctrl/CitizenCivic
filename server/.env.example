# ==========================================
# CitizenCivic Server Environment Variables
# ==========================================

PORT=8000
NODE_ENV=development

# Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://username:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Token Secret Key
JWT_SECRET=generate-a-strong-random-secret-key-for-jwt-signing

# OpenAI API Key (for civic triage and resolution audit)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Allowed CORS Origins
CORS_ALLOWED_ORIGINS=https://citizencivic-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Evidence Media Storage (local or s3)
MEDIA_STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=assets
AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your-s3-access-key-id
# AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
