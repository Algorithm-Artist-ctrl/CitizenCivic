# ==========================================
# CitizenCivic Environment Configuration
# ==========================================

# Server Configuration
PORT=8000
NODE_ENV=production

# Database (Neon PostgreSQL Connection with SSL)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=generate-a-strong-random-secret-key-for-jwt-signing

# OpenAI API (Server-side case triage and resolution verification)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://citizencivic-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# File Storage Configuration
# Set to 's3' for S3-compatible cloud storage (Neon Object Storage, Cloudflare R2, AWS S3), or 'local' for local disk
MEDIA_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=uploads
AWS_REGION=ap-southeast-1
AWS_S3_ADDRESSING_STYLE=path
# AWS_ENDPOINT_URL=https://<endpoint>.storage.<region>.neon.tech
# AWS_ENDPOINT_URL_S3=https://<endpoint>.storage.<region>.neon.tech
# AWS_ACCESS_KEY_ID=nak_live_your_key_id
# AWS_SECRET_ACCESS_KEY=nsk_live_your_secret_key

# Google Maps Platform (Optional geocoding & mapping)
# GOOGLE_MAPS_API=your-google-maps-api-key
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Frontend Environment Variable (Vite)
VITE_API_BASE_URL=https://citizencivic.onrender.com
