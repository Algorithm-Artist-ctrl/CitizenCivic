# CitizenCivic Environment Variables
# Copy this to .env and fill in actual values. DO NOT commit .env.

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (SQLite is default for dev; set for PostgreSQL in production)
# DATABASE_URL=postgres://citizencivic:password@localhost:5432/citizencivic

# Redis (optional, needed for Celery in Milestone 5+)
# REDIS_URL=redis://localhost:6379/0

# AI Integration (disabled by default)
AI_ENABLED=false
# GEMINI_API_KEY=your-key-here

# File Storage
MEDIA_STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email (console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
