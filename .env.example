# CitizenCivic Environment Variables
# Copy this to .env and fill in actual values. DO NOT commit .env.

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (PostgreSQL / Neon)
# DATABASE_URL=postgresql://user:password@endpoint.aws.neon.tech/neondb?sslmode=require
# NEON_REALTIME_URL=https://your-neon-realtime-endpoint.aws.neon.tech/

# Redis (optional, needed for Celery in Milestone 5+)
# REDIS_URL=redis://localhost:6379/0

# AI Integration (disabled by default)
AI_ENABLED=false
# GEMINI_API_KEY=your-key-here

# File Storage
MEDIA_STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email (console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
